  },
  "homepage": "https://github.com/duracelltomi/gtm4wp#readme",
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "adm-zip": "^0.5.18",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
