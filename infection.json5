{
    // Mutation testing (the mechanical form of .testing TS-15/TS-1): run
    // TARGETED at a changed component, not whole-suite - e.g.
    //   vendor/bin/infection src/Modules/EasyDigitalDownloads/ --threads=max
    // Needs a coverage driver; no PCOV/Xdebug is loaded in php.ini on the
    // maintainer machine, so load it via the scan dir (the env var reaches
    // PHPUnit's RunInSeparateProcess children, unlike a -d flag):
    //   PHP_INI_SCAN_DIR=';C:/Users/DuracellTomi/.php-ext/ini'
    // KNOWN LIMITATION (2026-09-02, re-tested 2026-09-07): on that machine's
    // PHP 8.4.15 ZTS Windows build, Infection exits silently (code 0, no error)
    // during "Processing source code files" - mutant generation never
    // completes. The initial coverage run works (PCOV fine; composer
    // test:coverage works). Reproduced with default tmpDir, single file,
    // --dry-run, one thread. **Not a version to wait out:** first seen on
    // 0.34/0.35, and 0.32.6 - the version pinned here since the PHP 8.2 CI leg
    // forced it, see U140 - does exactly the same, so this is the ZTS/Windows
    // environment rather than an Infection regression. Expected to work on an
    // NTS build or Linux; re-test after the next PHP bump, not the next
    // Infection one. Until then, targeted mutation testing is done by hand:
    // break one guard, assert the needle landed, run the matching suite,
    // restore (the method phases 3 and 4 used).
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [ "src" ]
    },
    "timeout": 30,
    "logs": {
        // build/ is git-ignored; mutation logs never belong in the public repo
        // (a surviving mutant on a security sink is unfixed-gap detail).
        "text": "build/infection-logs/infection.log",
        "summary": "build/infection-logs/summary.log"
    },
    "mutators": {
        "@default": true
    }
}
