#!/usr/bin/env bash
# Block a commit whose staged PHP violates the WordPress Coding Standards (phpcs.xml).
# Enabled by the same one-time setup as the commit-msg hook:
#   git config core.hooksPath .githooks
set -u

ROOT="$(git rev-parse --show-toplevel)"
PHPCS="$ROOT/vendor/bin/phpcs"

# Someone without dev dependencies installed should still be able to commit; CI runs the
# same phpcs and is the real gate. Failing open here beats failing confusingly.
if [ ! -f "$PHPCS" ]; then
  echo "pre-commit: vendor/bin/phpcs not found (run 'composer install') - skipping standards check." >&2
  exit 0
fi

# Passing explicit paths overrides the <file> targets in phpcs.xml, so this checks only
# the PHP being committed (~1s) instead of the whole tree (~20s). The ruleset's
# exclude-patterns still apply, so vendor/build/node_modules and tests/test-*.php drop
# out on their own and do not need to be filtered here.
#
# NB: this reads the working tree, not the staged blob. On a partially staged file you
# are therefore seeing your unstaged edits too. That is the usual pre-commit trade-off,
# taken deliberately over stash-juggling that can lose work when a hook dies mid-run.
FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$ROOT/$f" ] && FILES+=("$ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ "${#FILES[@]}" -eq 0 ]; then
  exit 0
fi

if "$PHPCS" -q "${FILES[@]}"; then
  exit 0
fi

cat >&2 <<'EOF'

BLOCKED: phpcs reported the violations above in the PHP you are committing.
  Mechanical (alignment, spacing, indentation):  vendor/bin/phpcbf <file>  -- then re-stage
  Anything else:                                 fix by hand
  Deliberate exception:                          add an exclude-pattern to phpcs.xml
  Escape hatch:                                  git commit --no-verify
EOF
exit 1
